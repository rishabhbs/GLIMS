# ──────────────────────────────────────────────────────────────────────────
# LIMS Brain — environment template. Copy to .env.local and fill in.
# NEVER commit real secrets. These live only in .env.local / Vercel settings.
# ──────────────────────────────────────────────────────────────────────────

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only service role key (full access; never exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI provider selection: 'openai' | 'anthropic' | 'google' | 'bedrock' | 'mock'
MODEL_PROVIDER=openai

# Chat/extraction model + embedding model (provider-specific identifiers)
BRAIN_CHAT_MODEL=gpt-4o-mini
BRAIN_EMBEDDING_MODEL=text-embedding-3-small
# Embedding dimension is a SCHEMA commitment — must match the vector(N) column.
# Note (google): use gemini-embedding-001, which supports 3072/1536/768 via
# Matryoshka output dims; keep this at 1536 to match the vector(1536) column.
BRAIN_EMBEDDING_DIMENSIONS=1536

# Provider API keys (only the selected provider's key is required)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Post graphic image generation ─────────────────────────────────────────
# The Studio draws a per-post graphic via an ImageProvider. Azure OpenAI is
# preferred when these three are set; otherwise it falls back to OPENAI_API_KEY
# (gpt-image-1). If none are set, posts simply render without a graphic.
AZURE_IMAGE_ENDPOINT=
AZURE_IMAGE_APIKEY=
AZURE_IMAGE_DEPLOYMENT=
# Optional: Azure images API version (defaults to a recent preview).
AZURE_IMAGE_API_VERSION=
# Optional override for the OpenAI (non-Azure) image model.
OPENAI_IMAGE_MODEL=gpt-image-1
# Amazon Bedrock: a Bedrock API key (bearer token) + region. BRAIN_CHAT_MODEL must
# be a region inference-profile id (e.g. 'au.anthropic.claude-haiku-4-5-...').
# Bedrock has no 1536-dim embedding here, so embeddings delegate to Google —
# keep GOOGLE_GENERATIVE_AI_API_KEY set when MODEL_PROVIDER=bedrock.
AWS_REGION=
AWS_BEARER_TOKEN_BEDROCK=

# Web research provider: 'gemini' | 'mock'
# 'gemini' uses Gemini's native Google Search grounding — NO separate search API.
# It reuses GOOGLE_GENERATIVE_AI_API_KEY (server-side only). 'mock' is offline/tests.
WEB_RESEARCH_PROVIDER=mock
# Gemini model used for research (must support Google Search grounding).
BRAIN_RESEARCH_MODEL=gemini-2.5-flash

# Default workspace id (seeded by migration). Single-workspace in Phase 1.
BRAIN_DEFAULT_WORKSPACE_ID=00000000-0000-0000-0000-000000000001

# Secret used to authorize the ingestion worker route (cron / internal calls)
INGEST_WORKER_SECRET=change-me
